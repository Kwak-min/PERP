# 서버 설정
PORT=8080
NODE_ENV=development

# 네이버 클라우드 PostgreSQL 접속 정보
# 형식: postgresql://유저명:비밀번호@호스트:포트/DB명
DATABASE_URL="postgresql://postgres:password@localhost:5432/room_reservation"

# 이메일 (Gmail SMTP 예시)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM="회의실 예약 시스템 <your-email@gmail.com>"

# 참석자 초대 링크 생성용 베이스 URL
BASE_URL=http://localhost:8080
