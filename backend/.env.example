PORT=8000
ORBITFLOW_DATABASE_FILE=./orbitflow.db
ORBITFLOW_AI_PROVIDER=echo
ORBITFLOW_EXTERNAL_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# 개인 API 키 암호화: 무작위 32바이트의 Base64. 미설정 시 개인 키 저장/사용은 503.
# 생성/보관/교체 절차는 README.md의 '개인 AI API 키' 참고.
ORBITFLOW_AI_KEY_ENCRYPTION_KEY=
OLLAMA_BASE_URL=http://localhost:11434
ORBITFLOW_WEBHOOK_SECRET=

# perp_db (PostgreSQL) - strangler-fig 데이터 접근 계층
# SSH 터널 사용 시 host=127.0.0.1, port=55432 (터널 로컬 포트)
PG_HOST=127.0.0.1
PG_PORT=55432
PG_DATABASE=perp_db
PG_USER=perpadmin
PG_PASSWORD=
# 또는 DATABASE_URL=postgres://perpadmin:PASSWORD@127.0.0.1:55432/perp_db
