PORT=8000
ORBITFLOW_DATABASE_FILE=./orbitflow.db
# 운영 원증빙/공유 파일은 API와 관련 작업이 같은 절대 영속 경로를 사용해야 한다.
# 실제 volume/mount/ACL/백업은 운영자가 확인한다. 이 예시는 설치/보존 보장이 아니다.
# ORBITFLOW_UPLOAD_DIR=D:/PERP-data/uploads
ORBITFLOW_UPLOAD_DIR=

# CSV raw/preview 만료 정리: 빈 값은 비활성. 선택한 서버 프로세스 하나에서만 켠다.
# 허용: legacy | perp_db | legacy,perp_db. 실패 시 다른 DB로 fallback하지 않는다.
# legacy를 선택하면 ORBITFLOW_DATABASE_FILE을 확인된 기존 DB의 절대 경로로 변경한다.
# perp_db는 DATABASE_URL의 host/port/user/database 또는 PG_HOST/PORT/DATABASE/USER를 명시한다.
ORBITFLOW_IMPORT_CLEANUP_STORES=
# 예: ORBITFLOW_IMPORT_CLEANUP_STORES=legacy,perp_db
# 영수증 staging은 독립 선택한다. CSV 선택만으로 켜지지 않으며 영수증만 켤 수도 있다.
# 허용: legacy | perp_db | legacy,perp_db. DB 명시 조건은 CSV와 같다.
# 활성화 전 ORBITFLOW_UPLOAD_DIR을 API와 같은 기존 절대 영속 디렉터리로 설정한다.
ORBITFLOW_RECEIPT_CLEANUP_STORES=
# 예: ORBITFLOW_RECEIPT_CLEANUP_STORES=legacy,perp_db
# 아래 기존 INTERVAL/TIMEOUT은 CSV와 영수증이 공유한다. 별도 영수증 timer는 없다.
# 성공한 서버 시작 뒤 첫 1시간에 실행, 이후 같은 주기. 범위 1000..2147483647 ms.
ORBITFLOW_IMPORT_CLEANUP_INTERVAL_MS=3600000
# kind/store별 worker 실행 상한: 100..INTERVAL_MS. 경합/실패는 다음 tick에서만 재시도.
ORBITFLOW_IMPORT_CLEANUP_TIMEOUT_MS=30000
# stdout expense_import_cleanup JSON의 kind=imports|receipts별 failed/성공 누락을 감시한다.
# startup의 stores/receipt_stores와 disabled/반복 skipped도 확인한다.
# receipts는 deleted/failed/shared 건수만 기록한다. shared>0은 보존된 참조를 운영자가 확인한다.
# 일부 unlink 실패는 failed/unlink_failed와 건수를 기록하고 다음 tick에서만 재시도한다.
# SIGINT/SIGTERM은 공통 timer 취소와 worker 종료를 기다린다. 외부 scheduler는 설치하지 않는다.
# 영수증은 만료된 미소비 writing|ready만 정리한다. 경로를 재귀 탐색하지 않는다.
# 장부/소비한 영수증 원본/공유 파일을 sweep하지 않으며 DB/WAL/backup 보존은 별도 정책이다.

# Wiki 통합 runtime의 strict local 전용 JSON. 빈 값은 모델 미설정이며 Echo/외부 fallback 없음.
# 실제 loaded model ID/context와 일치해야 한다. 이 예시는 모델 서버를 설치/기동하지 않는다.
# HTTP numeric loopback origin만 허용. LM Studio 호환 /api/v0/models metadata가 필요하다.
# WIKI_LOCAL_MODEL_CONFIG={"base_url":"http://127.0.0.1:12345","model":"replace-with-loaded-model-id","context_tokens":8192,"output_tokens":1024,"timeout_ms":120000,"temperature":0}
WIKI_LOCAL_MODEL_CONFIG=
ORBITFLOW_AI_PROVIDER=echo
ORBITFLOW_EXTERNAL_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# 개인 API 키 암호화: 무작위 32바이트의 Base64. 미설정 시 개인 키 저장/사용은 503.
# 생성/보관/교체 절차는 README.md의 '개인 AI API 키' 참고.
ORBITFLOW_AI_KEY_ENCRYPTION_KEY=
OLLAMA_BASE_URL=http://localhost:11434
ORBITFLOW_WEBHOOK_SECRET=

# perp_db (PostgreSQL) - strangler-fig 데이터 접근 계층
# SSH 터널 사용 시 host=127.0.0.1, port=55432 (터널 로컬 포트)
PG_HOST=127.0.0.1
PG_PORT=55432
PG_DATABASE=perp_db
PG_USER=perpadmin
PG_PASSWORD=
# 또는 DATABASE_URL=postgres://perpadmin:PASSWORD@127.0.0.1:55432/perp_db
