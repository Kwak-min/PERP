{
  "name": "orbitflow",
  "version": "1.0.0",
  "private": true,
  "description": "OrbitFlow - Node.js/Express + Vite/React workspace",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "test": "npm run test --workspace backend && npm run test --workspace frontend",
    "test:deadline": "node scripts/run_deadline_gate.mjs",
    "test:deadline:gate": "node scripts/run_deadline_isolated.mjs node --test scripts/deadline-gate.test.mjs",
    "start": "npm run start --workspace backend"
  }
}
